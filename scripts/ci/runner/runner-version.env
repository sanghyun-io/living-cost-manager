# LCM self-hosted runner — pinned bootstrap inputs + official appRoot layout.
# SHA-256 source: official actions/runner v2.338.0 GitHub release body
# ("SHA-256 Checksums" section), re-verified 2026-10-16 by downloading the
# osx-arm64 tarball and matching shasum -a 256 exactly.
#
# v2.338.0 osx-arm64 package inspection (2026-10-16, normal-owner extraction):
#   - entrypoints are config.sh / run.sh / env.sh / safe_sleep.sh /
#     run-helper.sh.template + bin/Runner.Listener (NO runsvc.sh, NO svc.sh —
#     the systemd/launchd svc templates are not shipped in this package).
#   - config.sh cd's to its own directory before invoking Runner.Listener,
#     so .credentials/.env/.runner/_work live inside the SAME appRoot as the
#     binaries. run.sh has identical self-locating semantics. The official
#     layout therefore REQUIRES one directory — a root-owned bundle split
#     from a CI working dir is not supported by the upstream scripts.
#
# Layout constants (single official appRoot under a fixed root-owned parent):
#   parent  = $LCM_CI_CI_BASE/lcm-production  (root:wheel 0755, immutable
#             control scripts + config + manifest live here, no secrets)
#   leaf    = $LCM_CI_APP_ROOT                (lcm-ci 0700, official tarball
#             extracted fresh-install-only by 02, renamed into place under the
#             root-owned parent; root never traverses it afterwards)
LCM_CI_ACCOUNT=lcm-ci
LCM_CI_RUNNER_VERSION=v2.338.0
LCM_CI_RUNNER_URL=https://github.com/actions/runner/releases/download/v2.338.0/actions-runner-osx-arm64-2.338.0.tar.gz
LCM_CI_RUNNER_SHA256=df4cebda25c86a886ed204e49fee63f5c2e7cec5f447b5c98440a826bbdf9df2
LCM_CI_REPO_URL=https://github.com/sanghyun-io/living-cost-manager
LCM_CI_REPO_API=repos/sanghyun-io/living-cost-manager
LCM_CI_OWNER=sanghyun-io
LCM_CI_RUNNER_NAME=lcm-prod-macmini-01
LCM_CI_RUNNER_LABELS=self-hosted,macOS,ARM64,lcm-production
LCM_CI_LAUNCHD_LABEL=com.gamjaworld.lcm-ci-actions-runner

# Path constants are env-overridable ONLY so the behaviour tests can run the
# real installer/validator logic against fixture trees as a normal user.
# Production provisioning uses the defaults; the sudoers-less owner wrappers
# never pass these variables.
LCM_CI_GAMJAWORLD_DIR="${LCM_CI_GAMJAWORLD_DIR:-/Library/Application Support/GamjaWorld}"
LCM_CI_CI_BASE="${LCM_CI_CI_BASE:-$LCM_CI_GAMJAWORLD_DIR/CI}"
LCM_CI_PARENT="${LCM_CI_PARENT:-$LCM_CI_CI_BASE/lcm-production}"
LCM_CI_APP_ROOT="${LCM_CI_APP_ROOT:-$LCM_CI_PARENT/app}"
LCM_CI_LOG_DIR="${LCM_CI_LOG_DIR:-/var/log/gamja-ci/lcm-production}"
# CI-owned home — created by 01-create-account.sh only, never read by root
# afterwards. LaunchAgent-style state must not live here; everything the
# daemon needs is under LCM_CI_PARENT/LEAF.
LCM_CI_HOME="${LCM_CI_HOME:-/Users/$LCM_CI_ACCOUNT}"
