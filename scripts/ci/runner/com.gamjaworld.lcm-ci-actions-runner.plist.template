<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>__LAUNCHD_LABEL__</string>
	<!-- Program is the ROOT-OWNED immutable wrapper in the install parent.
	     launchd drops uid/gid to UserName/GroupName BEFORE exec, so the
	     wrapper runs unprivileged and only execs the CI-owned official
	     run.sh after that UID drop. Root never executes leaf contents.
	     (The v2.338.0 osx package ships no service-control template at all
	     — verified by package inspection 2026-10-16; run.sh is the official
	     entrypoint, driven by this LaunchDaemon instead.) -->
	<key>ProgramArguments</key>
	<array>
		<string>__PARENT__/run-runner.sh</string>
	</array>
	<key>UserName</key>
	<string>__ACCOUNT__</string>
	<key>GroupName</key>
	<string>__ACCOUNT__</string>
	<!-- Official appRoot (leaf): config.sh/run.sh expect .credentials, .env,
	     .runner, _work/ to live in the same directory as their binaries. -->
	<key>WorkingDirectory</key>
	<string>__LEAF__</string>
	<key>RunAtLoad</key>
	<true/>
	<!-- Official run.sh semantics: retryable failures are re-launched inside
	     run.sh itself; a clean exit (0 — including after config.sh remove)
	     must NOT restart, avoiding the remove-then-crash-loop pattern.
	     Unexpected non-zero exits (wrapper validation failures, hard crashes)
	     restart after ThrottleInterval. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>EnvironmentVariables</key>
	<dict>
		<!-- INT/TERM forwarding to the runner process group for clean
		     bootout; without it run.sh's helper loop cannot be stopped
		     gracefully by launchd. -->
		<key>RUNNER_MANUALLY_TRAP_SIG</key>
		<string>1</string>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>HOME</key>
		<string>__ACCOUNT_HOME__</string>
	</dict>
	<!-- Log files are pre-created 0640 root:wheel by 02-install-bundle.sh in
	     the 0700 root-owned dir. launchd opens them as root and passes the
	     descriptors to the uid-dropped child. No file/directory ACLs exist
	     anywhere on this path, so there is no CI add_file/symlink role and
	     the CI user needs no path-traversal permission on the log dir. -->
	<key>StandardOutPath</key>
	<string>__LOG_DIR__/launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>__LOG_DIR__/launchd.err.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
</dict>
</plist>
