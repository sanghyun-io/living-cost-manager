#!/usr/bin/env bash
set -eu
FH="${FAKE_HOST:?}"
printf 'ssh %s\n' "$*" >>"$FH/state/calls.log"
while [ "$#" -gt 0 ] && [ "$1" != gamja-oci ]; do shift; done
[ "$#" -gt 0 ]; shift
# Exactly OpenSSH: join ALL post-host argv, then OUTER shell parses it.
joined="$*"
joined="${joined//\/opt\/livingcost/$FH/opt/livingcost}"
exec sh -c "$joined"
