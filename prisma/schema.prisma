generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  name            String
  passwordHash    String
  tokenVersion    Int               @default(0)
  emailVerifiedAt DateTime?
  memberships     WorkspaceMember[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  pushSubscriptions       PushSubscription[]
  pushDeliveries          PushDelivery[]
  templates               BudgetTemplate[]
  serviceSubscription     ServiceSubscriptionContract?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

// Application service revenue, deliberately separate from customer FixedCost.
model ServiceSubscriptionContract {
  id String @id @default(cuid())
  userId String? @unique
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  subjectId String @unique
  provider String
  storeId String
  environment String
  planId String?
  status String @default("idle")
  originalAnchor DateTime?
  nextCycle Int @default(0)
  cancelRequested Boolean @default(false)
  renewalStopped Boolean @default(false)
  providerCancellationStatus String @default("none")
  version Int @default(0)
  createdAt DateTime @default(now())
  quotes ServiceBillingQuote[]
  instruments ServiceBillingInstrument[]
  attempts ServicePaymentAttempt[]
  periods ServicePaidPeriod[]
  @@unique([id, provider, storeId, environment])
  @@index([status, renewalStopped])
}

model ServiceBillingQuote {
  id String @id @default(cuid())
  contractId String
  provider String
  storeId String
  environment String
  channelId String
  contract ServiceSubscriptionContract @relation(fields: [contractId, provider, storeId, environment], references: [id, provider, storeId, environment], onDelete: Restrict)
  catalogVersion String
  planId String
  totalAmount Int
  currency String
  periodMonths Int
  billingVersion String
  autoRenewVersion String
  featureScopeVersion String @default("feature-draft-v1")
  policyVersion String @default("policy-draft-v1")
  sellerVersion String @default("seller-draft-v1")
  premiumScope String @default("provisional")
  materialsSnapshot Json?
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  attempts ServicePaymentAttempt[]
  instruments ServiceBillingInstrument[]
  @@index([contractId, expiresAt])
}

model ServiceBillingInstrument {
  id String @id @default(cuid())
  contractId String
  provider String
  storeId String
  environment String
  contract ServiceSubscriptionContract @relation(fields: [contractId, provider, storeId, environment], references: [id, provider, storeId, environment], onDelete: Restrict)
  quoteId String @unique
  quote ServiceBillingQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  issuanceId String @unique
  status String @default("prepared")
  ciphertext Bytes?
  nonce Bytes?
  authTag Bytes?
  keyVersion String?
  verifiedAt DateTime?
  revokedAt DateTime?
  version Int @default(0)
  leaseOwner String?
  leaseUntil DateTime?
  attempts ServicePaymentAttempt[]
  @@index([contractId, status])
}

model ServicePaymentAttempt {
  id String @id @default(cuid())
  contractId String
  provider String
  storeId String
  environment String
  contract ServiceSubscriptionContract @relation(fields: [contractId, provider, storeId, environment], references: [id, provider, storeId, environment], onDelete: Restrict)
  quoteId String @unique
  quote ServiceBillingQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  instrumentId String
  instrument ServiceBillingInstrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  cycle Int
  paymentId String
  idempotencyKey String
  requestBinding String
  totalAmount Int
  currency String
  billingVersion String
  autoRenewVersion String
  acceptedAt DateTime
  status String @default("created")
  dispatchAt DateTime?
  leaseOwner String?
  leaseUntil DateTime?
  fence Int @default(0)
  lookupCount Int @default(0)
  nextLookupAt DateTime?
  paidAt DateTime?
  reviewRequired Boolean @default(false)
  createdAt DateTime @default(now())
  period ServicePaidPeriod?
  events ServiceBillingEventReceipt[]
  refunds ServiceRefundRecord[]
  @@unique([provider, storeId, environment, paymentId])
  @@unique([contractId, cycle])
  @@unique([contractId, idempotencyKey])
  @@index([status, nextLookupAt, leaseUntil])
}

model ServicePaidPeriod {
  id String @id @default(cuid())
  attemptId String @unique
  attempt ServicePaymentAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  contractId String
  contract ServiceSubscriptionContract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  cycle Int
  environment String
  startsAt DateTime
  endsAt DateTime
  accessEndsAt DateTime
  verifiedAt DateTime
  @@unique([contractId, cycle])
  @@index([contractId, startsAt, endsAt])
}

model ServiceBillingEventReceipt {
  id String @id @default(cuid())
  provider String
  storeId String
  environment String
  eventId String
  paymentId String
  attemptId String?
  attempt ServicePaymentAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  receivedAt DateTime @default(now())
  processedAt DateTime?
  status String @default("pending")
  retryCount Int @default(0)
  nextRetryAt DateTime?
  leaseOwner String?
  leaseUntil DateTime?
  fence Int @default(0)
  @@unique([provider, storeId, environment, eventId])
  @@index([attemptId, status])
  @@index([status, nextRetryAt, leaseUntil])
}

model ServiceRefundRecord {
  id String @id @default(cuid())
  attemptId String
  attempt ServicePaymentAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  provider String
  storeId String
  environment String
  idempotencyKey String
  requestAmount Int
  reasonCode String
  status String @default("requested")
  providerCancelId String?
  verifiedAmount Int?
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  approvalOperationId String? @unique
  approvalPolicyVersion String?
  leaseOwner String?
  leaseUntil DateTime?
  fence Int @default(0)
  lookupCount Int @default(0)
  nextLookupAt DateTime?
  @@unique([attemptId, idempotencyKey])
  @@unique([provider, storeId, environment, providerCancelId])
  @@index([status, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// 발송 이력 — 중복 발송 방지용. dedupeKey 는 "발송 대상 날짜"(YYYY-MM-DD,
// 묶음 발송이므로 사용자당 하루 1건). (userId, dedupeKey) 가 unique 이므로
// 배치를 같은 날 재실행해도 한 번만 발송된다.
model PushDelivery {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dedupeKey String
  sentAt    DateTime @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id            String                @id @default(cuid())
  name          String
  monthlyIncome Int                   @default(0)
  syncVersion   Int                   @default(0)
  members       WorkspaceMember[]
  invitations   WorkspaceInvitation[]
  categories    Category[]
  cards         PaymentCard[]
  fixedCosts    FixedCost[]
  backups       BackupSnapshot[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceInvitationRole
  status      WorkspaceInvitationStatus @default(pending)
  tokenHash   String        @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@index([email])
  @@index([workspaceId])
}

enum WorkspaceRole {
  owner
  editor
  viewer
}

enum WorkspaceInvitationRole {
  editor
  viewer
}

enum WorkspaceInvitationStatus {
  pending
  accepted
  revoked
  expired
}

model Category {
  id          String
  workspaceId String
  label       String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fixedCosts  FixedCost[] @relation("FixedCostCategory")

  @@id([workspaceId, id])
  @@unique([workspaceId, label])
}

model PaymentCard {
  id           String
  workspaceId  String
  label        String
  billingDay   Int
  isEndOfMonth Boolean @default(false)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fixedCosts  FixedCost[] @relation("FixedCostPaymentCard")

  @@id([workspaceId, id])
}

model FixedCost {
  id              String
  workspaceId     String
  name            String
  categoryId      String
  paymentMethodId String
  paymentCardId    String?
  paymentOptionKey String?
  amount          Int
  periodMonths    Float     @default(1)
  billingAnchorDate String?
  renewalStatus String @default("unreviewed")
  potentialMonthlySavings Int @default(0)
  confirmedMonthlySavings Int @default(0)
  billingDay      Int
  isEndOfMonth    Boolean   @default(false)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category        Category  @relation("FixedCostCategory", fields: [workspaceId, categoryId], references: [workspaceId, id])
  paymentCard     PaymentCard? @relation("FixedCostPaymentCard", fields: [workspaceId, paymentCardId], references: [workspaceId, id], onDelete: NoAction)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@id([workspaceId, id])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, paymentCardId])
}

model BackupSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  payload     Json
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// Private, account-owned blueprints, never linked to financial workspaces.
model BudgetTemplate {
  id        String @id @default(cuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  revision  Int @default(1)
  blueprint Json
  share     BudgetTemplateShare?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// One bounded published snapshot per template; new publication invalidates
// the previous token. Draft edits never change an already published snapshot.
model BudgetTemplateShare {
  templateId String @id
  template   BudgetTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  token      String @unique
  blueprint  Json
  expiresAt  DateTime
  revokedAt  DateTime?
}
