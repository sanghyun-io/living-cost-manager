{
  "name": "living-cost-manager",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @living-cost-manager/web dev",
    "build": "pnpm -r --if-present build",
    "start": "pnpm --filter @living-cost-manager/web start",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter @living-cost-manager/api test",
    "test:web": "pnpm --filter @living-cost-manager/web test",
    "verify:usability": "node scripts/verify-usability.mjs",
    "test:marketing": "node --test scripts/marketing/*.test.mjs",
    "verify:marketing": "node scripts/verify-marketing.mjs",
    "verify:pricing": "pnpm --filter @living-cost-manager/shared build && node scripts/verify-pricing.mjs",
    "smoke:public": "pwsh -NoProfile -File scripts/public-smoke.ps1",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "playwright": "1.58.2",
    "prisma": "^6.19.0"
  },
  "packageManager": "pnpm@11.1.3"
}
